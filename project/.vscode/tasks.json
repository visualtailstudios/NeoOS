{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Neo OS",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/project/Neo.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}/project"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
